# Virtual environments
.venv/
venv/
env/
.local_db/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment variables
.env
.env.*.local
.env.install

# Logs, PIDs, and local runtime state
*.log
*.pid
.installer.pid
.service.pid
.enabled

# Native cloned sub-projects
services/router/src/
services/*/venv/
services/*/.venv/

# Data and Models
models/
data/
services/*/data/
dump.rdb

# Weights & Checkpoints (never commit large model binaries)
*.pt
*.pth
*.ckpt
*.safetensors
*.gguf
*.bin

# Voice clones & audio artifacts (user-specific)
services/tts/voices/*
!services/tts/voices/.gitkeep
services/tts/*.wav
*.wav
!services/tts/voxcpm2/examples/*.wav
!dev/**/*.wav

# Compiled Binaries and Executables
*.exe
*.dll
*.so
*.dylib

# Downloaded Archives & Checksums
*.zip
*.tar.gz
*.7z
*.sha256
latest_release.json

# Ignore specific service binaries
services/llm/llama-cpp/bin/
services/embedding/llama-cpp-embed/bin/

# OmniVoice-GGUF (lightweight CPU binaries tracked, heavy CUDA dll ignored)
!services/tts/omnivoice-gguf/bin/tts-server.exe
!services/tts/omnivoice-gguf/bin/omnivoice-codec.exe
!services/tts/omnivoice-gguf/bin/ggml.dll
!services/tts/omnivoice-gguf/bin/ggml-cpu.dll
!services/tts/omnivoice-gguf/bin/ggml-base.dll
services/tts/omnivoice-gguf/bin/*cuda*
services/tts/omnivoice-gguf/bin/cpu/
services/tts/omnivoice-gguf/bin/cuda/
services/tts/omnivoice-gguf/build/
services/tts/omnivoice-gguf/.extract_staging/

{
  "id": "whisper-stt",
  "name": "Faster Whisper STT",
  "category": "stt",
  "description": "Fast and efficient Speech-to-Text server. OpenAI-compatible API support.",
  "version": "1.10.0",
  "vram_required_gb": 2,
  "parameters": {
    "GPU_DEVICE_IDS": { "type": "gpu_selector", "label": "GPUs to Use", "default": "all" },
    "WHISPER_COMPUTE_TYPE": {"default": "int8_float16", "label": "Compute Type"}
  },
  "models_path": "models/",
  "models_catalog": [
    {
      "id": "whisper-small-finetuned-tr",
      "name": "Whisper Small (Turkish Finetuned)",
      "folder": "whisper-small-finetuned-tr",
      "description": "Özel Türkçe sesli asistan veri seti ile ince ayar (fine-tune) yapılmış CTranslate2 modeli.",
      "size_mb": 485,
      "files": [
        "model.bin",
        "config.json",
        "vocabulary.json"
      ],
      "env": {
        "WHISPER_MODEL": "whisper-small-finetuned-tr"
      }
    },
    {
      "id": "whisper-small-official",
      "name": "Whisper Small (Official Systran)",
      "folder": "whisper-small-official",
      "description": "Resmi OpenAI Whisper Small CTranslate2 modeli.",
      "download_url": "https://huggingface.co/Systran/faster-whisper-small/resolve/main/",
      "size_mb": 484,
      "files": [
        "model.bin",
        "config.json",
        "vocabulary.json"
      ],
      "env": {
        "WHISPER_MODEL": "whisper-small-official"
      }
    }
  ],
  "supports": ["nvidia", "cpu"],
  "default_hardware": "nvidia",
  "supported_environments": [
    {
      "id": "stt-nv-cuda",
      "name": "NVIDIA - CUDA",
      "base_image": "docker.io/fedirz/faster-whisper-server:latest-cuda",
      "hardware": "nvidia"
    },
    {
      "id": "stt-cpu",
      "name": "CPU Only",
      "base_image": "docker.io/fedirz/faster-whisper-server:latest-cpu",
      "hardware": "cpu"
    }
  ],
  "compose_files": {
    "nvidia": "docker-compose.nvidia.yml",
    "cpu": "docker-compose.cpu.yml"
  },
  "api": {
    "style": "openai-compatible",
    "endpoint": "/v1/audio/transcriptions"
  },
  "status": "enabled"
}

# =============================================================
#  Orion Global Konfigürasyon
#
#  Bu dosya bu depodaki servislerin (Hub, ses ve LLM sunucuları) ortak
#  "adres defteri"dir:
#  - *_HOST: Docker ağı içindeki konteyner adı. Docker olmadan çalışırken
#    (kurulu Orion, kaynaktan çalıştırma) bu adlar 127.0.0.1 olarak okunur.
#  - *_PORT: host makinede açılan port; *_CONTAINER_PORT: konteyner içindeki port.
#  - *_PROJECT_NAME: Docker Compose proje adı (installer okur).
#
#  Orion Router bu dosyayı OKUMAZ; kendi deposundaki .env dosyasını kullanır.
#  Hub, Router'ı başlatırken bu dosyanın değerlerini ona geçirmez
#  (services/shared/launcher.py: router_environment). Docker'da Router
#  konteynerine yalnızca services/router/docker-compose.yml içinde adı geçen
#  değerler verilir.
#
#  Servis-özgü ayarlar (model boyutu, GPU katmanı vb.) için her servisin kendi
#  klasöründeki .env dosyasına bak. Makineye özel değerler:
#  <veri klasörü>/services/.env.global.local (örnek: .env.global.local.example).
# =============================================================

# --- Docker Ağı ---
# NOT: Bu ağ adının ('orion-network') tüm servislerde (router, hub, vb.) aynı kalması
# servislerin birbirleriyle Docker iç ağı üzerinden (daha hızlı ve güvenli) haberleşebilmesi için önemlidir.
# Zorunlu olmadıkça değiştirmeyin.
ORION_NETWORK=orion-network
DEFAULT_LISTEN_HOST=0.0.0.0
INSTALLER_PORT=7171

# --- LLM, Embedding, TTS, STT sunucuları ---
# Hub bunlara doğrudan bağlanmaz; her istek Router üzerinden gider. *_PORT değerlerini
# sunucuların kendisi dinlemek için okur. *_HOST değerleri yalnızca Docker'dadır: Router
# konteyneri bu adlarla bağlanır. Docker olmadan Router adresleri kendi .env'inden alır;
# bir port değişirse Router'ın .env'inde de değiştir.
LLM_PROJECT_NAME=orion-llm
LLM_HOST=llama-cpp
LLM_PORT=8085
LLM_CONTAINER_PORT=8080

EMBEDDING_PROJECT_NAME=orion-embedding
EMBED_HOST=llama-cpp-embed
EMBED_PORT=8086
EMBED_CONTAINER_PORT=8080

TTS_PROJECT_NAME=orion-tts
TTS_HOST=tts
TTS_PORT=8810
TTS_CONTAINER_PORT=8810

STT_PROJECT_NAME=orion-stt
STT_HOST=stt
STT_PORT=9009
STT_CONTAINER_PORT=9009

# --- Hub'ın kendi veritabanı ve kuyruğu ---
# Router'ın veritabanı ayrıdır (Router .env'i; Docker'da router-db konteyneri).
REDIS_HOST=redis
REDIS_PORT=6379

POSTGRES_HOST=postgres
POSTGRES_PORT=5445
POSTGRES_DB=orion
POSTGRES_USER=orion
POSTGRES_PASSWORD=orion

# --- Orion Hub API (Docker) ---
HUB_PROJECT_NAME=orion-hub
HUB_HOST=api
HUB_PORT=8909
HUB_CONTAINER_PORT=8909

# --- Orion Hub Worker (Docker) ---
WORKER_HOST=worker

# --- Load Balancer (Nginx, Docker) ---
LB_PORT=8090
NGINX_HOST=lb
NGINX_CONTAINER_PORT=80
API_2_HOST=api-2

# --- Orion Router ---
# Hub hangi Router'a bağlanacağını panelden seçilen kayıttan bilir
# (Panel → Router bağlantısı; router-connection.json). ROUTER_HOST yalnızca hiç
# Router seçilmemişken kullanılan yedek adrestir: Docker'da konteyner adı, Docker
# olmadan bu bilgisayar (https://127.0.0.1:<ORION_ROUTER_TLS_PORT, varsayılan 9443>).
# Bu yedek adrese de ancak Router kimliği doğrulanınca bağlanılır.
ROUTER_HOST=router
# Aşağıdakiler yalnızca Docker'daki Router konteynerine verilir (services/router/docker-compose.yml).
APP_REFERER=https://orion-ai-assistant.github.io/orion-ai-assistant
APP_TITLE="Orion AI Assistant"
APP_CATEGORIES="personal-agent,cli-agent"

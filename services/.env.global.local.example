# =============================================================
# Orion Global Local Settings Example
# =============================================================

# --- Admin API ---
ADMIN_API_KEY=orion

# --- Orion Router ---
# The Hub never uses the Router's administrator password. Select the Router in the Hub panel
# (localhost:8910/panel/router/): a Router on this PC connects by itself, another one with a
# one-time connection code from the Router dashboard.
# Only the Docker Router container reads this (services/router/docker-compose.yml):
ADMIN_SECRET=orion
# Where the selected Router is saved; the default is the Hub's data folder.
# ORION_ROUTER_CONNECTION_FILE=<persistent-data>/router-connection.json
# Fallback before any Router is selected: see ROUTER_HOST in .env.global.
# Leave unset: every user reaches the Router with their own account key. When set, requests that
# carry no account key (tests, automation) use this Router account key instead.
# ROUTER_API_KEY=

# --- Hub HTTP entry ---
# Always loopback-only: the Orion window's API and the management panel (/panel).
# ORION_LOCAL_PORT=8910
# ORION_ROUTER_LOCAL_PORT=20128

# --- Local model services (TTS, STT, LLM, embeddings) ---
# 127.0.0.1: only programs on this PC (the Router). 0.0.0.0 only when the Router runs on
# another computer. See services/.env.global.
# ORION_SERVICES_BIND_HOST=127.0.0.1

# --- Flutter UI (/, /hub and old /dashboard links open it) ---
# ORION_FLUTTER_PORT=8090
# ORION_FLUTTER_APP_DIR=D:/path/to/orion-ai-assistant-flutter/main_app/app
# ORION_FLUTTER_AUTOSTART=1
# ORION_FLUTTER_OPEN_WINDOW=1
# ORION_MDNS=1

# --- CLI Language ---
# System language for CLI and output (e.g. 'en', 'tr')
# If left empty, installer will auto-detect and append it here.
# CLI_LANG=en
